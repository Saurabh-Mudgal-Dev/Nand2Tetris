CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Or(a=a, b=b, out=x);
    And(a=a, b=b, out=y);
    Not(in=y, out=noty);
    And(a=x, b=noty, out=out);
}

CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Nand(a=a, b=b, out=n1);
    Nand(a=a, b=n1, out=n2);
    Nand(a=b, b=n1, out=n3);
    Nand(a=n2, b=n3, out=out);
}